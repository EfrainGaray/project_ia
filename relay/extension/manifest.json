{
  "manifest_version": 3,
  "name": "Relay de recetas",
  "version": "0.1.0",
  "description": "Ejecuta recetas locales en una pestaña marcada de tu Chrome. Nunca envía sin tu aprobación.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Relay de recetas"}
}
